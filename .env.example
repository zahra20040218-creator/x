# ---- API ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Postgres (ALWAYS through PgBouncer - CLAUDE.md 3.3) ----
# Port 6432 is PgBouncer. Never point this at Postgres 5432 directly.
DATABASE_URL=postgresql://rideapp:CHANGE_ME@pgbouncer:6432/rideapp
DATABASE_MAX_CONNECTIONS=10

# Direct connection is ONLY for running migrations, never for app runtime.
DATABASE_MIGRATION_URL=postgresql://rideapp:CHANGE_ME@postgres:5432/rideapp

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Firebase Phone Auth ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# ---- Auth ----
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Matching ----
MATCH_SEARCH_RADIUS_METERS=5000
MATCH_OFFER_TIMEOUT_SECONDS=15
MATCH_CLAIM_TTL_MS=30000
MATCH_MAX_DRIVERS_PER_RIDE=8

# ---- Location ----
LOCATION_FLUSH_INTERVAL_MS=30000
LOCATION_FLUSH_BATCH_SIZE=500
DRIVER_PRESENCE_TTL_SECONDS=60

# ---- Idempotency ----
IDEMPOTENCY_TTL_SECONDS=86400

# ---- CORS ----
# Allowlist for browser clients (the admin panel). NEVER "*": the API is called
# with a bearer token, and a wildcard would let any site issue admin requests
# from a logged-in operator's browser. Empty = mobile apps only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Integration tests (optional; unit tests run without these) ----
# TEST_REDIS_URL=redis://localhost:6379
# TEST_DATABASE_URL=postgresql://rideapp:rideapp@localhost:5432/rideapp_test

# --- Rate limiting -----------------------------------------------------------
# Divides a route's Redis limit to produce the PER-INSTANCE limit used while
# Redis is unreachable. SET THIS TO THE NUMBER OF API INSTANCES YOU RUN.
# The fallback counter lives in process memory, so N instances each permit this
# many: leaving it at 1 with 4 instances makes the effective limit 4x intended.
RATE_LIMIT_LOCAL_DIVISOR=4

# How long the limiter waits for Redis before treating it as unavailable.
# Small on purpose: ioredis queues commands while disconnected rather than
# rejecting them, so without this a hung Redis adds its full latency to every
# request on the hot path.
RATE_LIMIT_REDIS_TIMEOUT_MS=50

# --- Push notifications (FCM) ------------------------------------------------
# Firebase service account JSON, on one line, for FCM HTTP v1.
#
# SECRET: contains a private key. ENV only, never committed.
#
# Without it the API and worker still boot and still enqueue push jobs, but
# every delivery is reported as a transient failure and logged at warn. Nothing
# reports success it did not achieve, and no real device token is ever marked
# invalid because OUR credentials are missing.
#
# WITHOUT THIS, A DRIVER WHOSE APP IS IN THE BACKGROUND RECEIVES NO RIDE
# OFFERS. Offers expire in 15 seconds.
FCM_SERVICE_ACCOUNT_JSON=

# --- Observability -----------------------------------------------------------
# Bearer token required to scrape /v1/metrics. Minimum 16 characters.
#
# When unset the endpoint returns 404 and metrics are NOT exposed. Fail-closed
# on purpose: ride volume and error rates are operational and competitive
# information, and an endpoint open by default is open in production too.
METRICS_TOKEN=

# --- Deployment topology -----------------------------------------------------
# Set to `true` ONLY when the API sits behind a reverse proxy you control
# (nginx, a load balancer). It makes Express honour X-Forwarded-For.
#
# Both mistakes are silent and both break rate limiting:
#
#   Unset behind a proxy  - every request appears to come from the proxy's
#                           address, so all clients share one bucket and one
#                           abusive caller rate-limits the entire city.
#
#   Set with no proxy     - any client can send its own X-Forwarded-For and
#                           reset its bucket at will, which is no rate limit.
#
# Defaults to unset, which is correct for running the API directly.
TRUST_PROXY=
