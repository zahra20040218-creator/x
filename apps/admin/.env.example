# Admin panel configuration.
#
# The API base. In development the Vite proxy forwards /v1 to the API, so the
# default relative value works without CORS.
VITE_API_BASE_URL=/v1

# Firebase phone auth. The admin panel signs in with the SAME OTP flow as the
# mobile apps, because the API only accepts a Firebase ID token - there is no
# password login anywhere in this system.
#
# WITHOUT THESE, NOBODY CAN LOG IN TO THE ADMIN PANEL. They are not secrets:
# every one of these values ships inside any Firebase web client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
