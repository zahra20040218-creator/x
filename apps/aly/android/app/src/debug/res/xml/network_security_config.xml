<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file lives under src/debug and is never merged into
  a release bundle.

  Android blocks cleartext by default from API 28, so the development default
  (http://10.0.2.2:3000 - the emulator's route to the host) could not connect
  on either app. The symptom is a plain network error, which reads exactly like
  a server that is not running.

  Only the two host aliases are listed. A blanket cleartextTrafficPermitted
  would also cover every third-party endpoint the app happens to reach, in a
  build people run on real handsets.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator -> host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Genymotion. -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
