{
  "name": "@rideapp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node --experimental-strip-types src/db/migrate.ts up",
    "migrate:down": "node --experimental-strip-types src/db/migrate.ts down",
    "seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "bullmq": "5.58.5",
    "express": "5.1.0",
    "ioredis": "5.8.2",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.18.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@nestjs/testing": "11.1.6",
    "@swc/core": "1.13.5",
    "@types/express": "5.0.3",
    "@types/node": "24.9.2",
    "@types/pg": "8.15.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.38.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
